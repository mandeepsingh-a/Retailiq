# Data (regenerated by run_pipeline.py — don't bloat the repo with generated CSVs)
data/raw/*.csv
data/processed/*.csv
data/processed/*.db

# Models (regenerated by training scripts — binary, don't version)
models/*.joblib

# NOTE: reports/figures/*.png and reports/*.json ARE committed on purpose —
# they're the evidence (charts + metrics) the README displays, so a visitor
# can see real results without having to run the pipeline first.

# Keep folder structure for the ignored dirs
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/
venv/
.venv/

# Test artifacts
tests/_tmp_*.csv

# OS / editor
.DS_Store
.vscode/
.idea/
